# SN Haber — Ortam Değişkenleri Örneği
# Bu dosya bir ŞABLONDUR; gerçek anahtar/gizli bilgi İÇERMEZ.
# Kullanmak için bu dosyayı ".env.local" olarak kopyalayın ve
# aşağıdaki placeholder değerleri kendi gerçek bilgilerinizle değiştirin.
# ".env.local" dosyası ASLA git'e commit edilmemelidir (.gitignore içinde tanımlıdır).

# ------------------------------------------------------------------
# Genel / Site
# ------------------------------------------------------------------

# Sitenin canlı domaini (protokolsüz, sadece host adı).
# OpenGraph görselleri, JSON-LD, RSS feed ve metadata URL'lerinde kullanılır.
NEXT_PUBLIC_DOMAIN=snhaber.duckdns.org

# ------------------------------------------------------------------
# Supabase (Veritabanı)
# ------------------------------------------------------------------
# Supabase projenizi https://app.supabase.com üzerinden oluşturup
# Project Settings > API sayfasından aşağıdaki değerleri alın.

# Supabase proje URL'si (Project Settings > API > Project URL).
NEXT_PUBLIC_SUPABASE_URL=buraya-supabase-proje-url-yapistirin

# Supabase anon (public) API anahtarı — tarayıcıda güvenle kullanılabilir,
# Row Level Security politikalarına tabidir (Project Settings > API > anon public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=buraya-supabase-anon-key-yapistirin

# Supabase service_role anahtarı — SADECE sunucu tarafında (RSS ingest
# pipeline, Vercel Cron Job) kullanılır. Row Level Security'yi atlar.
# ASLA tarayıcıya veya public koda sızdırılmamalıdır
# (Project Settings > API > service_role secret).
SUPABASE_SERVICE_ROLE_KEY=buraya-supabase-service-role-key-yapistirin

# ------------------------------------------------------------------
# Upstash Redis (Cache / Dedup)
# ------------------------------------------------------------------
# https://console.upstash.com üzerinden bir Redis veritabanı oluşturup
# "REST API" sekmesinden aşağıdaki değerleri alın.

# Upstash Redis REST URL'si.
UPSTASH_REDIS_REST_URL=buraya-upstash-redis-rest-url-yapistirin

# Upstash Redis REST token'ı.
UPSTASH_REDIS_REST_TOKEN=buraya-upstash-redis-rest-token-yapistirin

# ------------------------------------------------------------------
# AI Servisleri
# ------------------------------------------------------------------

# Groq API anahtarı — Llama-3 ile başlık/özet hızlı işleme için kullanılır.
# https://console.groq.com/keys üzerinden alınabilir.
GROQ_API_KEY=buraya-groq-api-key-yapistirin

# Google Gemini API anahtarı — Gemini Flash ile detaylı analiz, doğrulama,
# kategorizasyon ve embedding üretimi için kullanılır.
# https://aistudio.google.com/app/apikey üzerinden alınabilir.
GEMINI_API_KEY=buraya-gemini-api-key-yapistirin

# ------------------------------------------------------------------
# Otomasyon / Güvenlik
# ------------------------------------------------------------------

# Vercel Cron Job'ların /api/cron/* uç noktalarını çağırırken kullandığı
# gizli anahtar. Bu değeri kendiniz üretip (örn. bir UUID) hem buraya hem
# de Vercel proje ortam değişkenlerine ekleyin; route handler, gelen
# isteğin Authorization header'ında bu değeri taşıdığını doğrular.
CRON_SECRET=buraya-rastgele-guclu-bir-gizli-anahtar-yapistirin